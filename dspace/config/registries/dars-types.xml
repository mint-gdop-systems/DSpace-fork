<?xml version="1.0" encoding="utf-8"?>
<dspace-dc-types>

    <dspace-header>
        <title>Custom DARS Types Registry</title>
    </dspace-header>

    <dc-schema>
        <name>dars</name>
        <namespace>http://dspace.org/dars/</namespace>
    </dc-schema>

    <!-- Document Info -->
    <dc-type>
        <schema>dars</schema>
        <element>document</element>
        <qualifier>number</qualifier>
        <scope_note>Document Number</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>document</element>
        <qualifier>date</qualifier>
        <scope_note>Contract/Registration Date</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>document</element>
        <qualifier>attachments</qualifier>
        <scope_note>Attachment Count</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>document</element>
        <qualifier>revokedNumber</qualifier>
        <scope_note>Revoked Document Number</scope_note>
    </dc-type>

    <dc-type>
        <schema>dars</schema>
        <element>branch</element>
        <qualifier>location</qualifier>
        <scope_note>Branch Location</scope_note>
    </dc-type>

    <dc-type>
        <schema>dars</schema>
        <element>file</element>
        <qualifier>pageCount</qualifier>
        <scope_note>Number of pages in the File. (ፋይል የገጽ ቁጥር)</scope_note>
    </dc-type>

    <dc-type>
        <schema>dars</schema>
        <element>file</element>
        <qualifier>type</qualifier>
        <scope_note>Specific File Type. (የፋይል ዓይነት) </scope_note>
    </dc-type>



    <!-- Demographics -->
    <dc-type>
        <schema>dars</schema>
        <element>demographics</element>
        <qualifier>femaleCount</qualifier>
        <scope_note>Female Count</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>demographics</element>
        <qualifier>maleCount</qualifier>
        <scope_note>Male Count</scope_note>
    </dc-type>

    <!-- Parties -->
    <dc-type>
        <schema>dars</schema>
        <element>giver</element>
        <qualifier>name</qualifier>
        <scope_note>Giver/Testator Full Name</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>receiver</element>
        <qualifier>name</qualifier>
        <scope_note>Receiver/Beneficiary Full Name</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>officer</element>
        <qualifier>name</qualifier>
        <scope_note>Officer Name</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>dataEncoder</element>
        <qualifier>name</qualifier>
        <scope_note>Data Encoder Name</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>investigator</element>
        <qualifier>name</qualifier>
        <scope_note>Investigator Name</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>stampOfficer</element>
        <qualifier>name</qualifier>
        <scope_note>Stamp Duty Officer Name</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>giver</element>
        <qualifier>type</qualifier>
        <scope_note>Individual or Organization</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>receiver</element>
        <qualifier>type</qualifier>
        <scope_note>Individual or Organization</scope_note>
    </dc-type>

    <!-- Classifications -->
    <dc-type>
        <schema>dars</schema>
        <element>service</element>
        <qualifier>type</qualifier>
        <scope_note>Main Service Type</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>document</element>
        <qualifier>type</qualifier>
        <scope_note>Sub Document Type</scope_note>
    </dc-type>

