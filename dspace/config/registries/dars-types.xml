    <dc-type>
        <schema>dars</schema>
        <element>vehicle</element>
        <qualifier>chassis</qualifier>
        <scope_note>Chassis Number</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>vehicle</element>
        <qualifier>motor</qualifier>
        <scope_note>Motor Number</scope_note>
    </dc-type>

    <!-- Property Asset -->
    <dc-type>
        <schema>dars</schema>
        <element>property</element>
        <qualifier>carta</qualifier>
        <scope_note>Carta Number</scope_note>
    </dc-type>
