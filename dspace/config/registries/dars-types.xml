    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>loan</element>
        <qualifier>endDate</qualifier>
        <scope_note>Loan End Date</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>loan</element>
        <qualifier>amount</qualifier>
        <scope_note>Loan Amount</scope_note>
    </dc-type>

