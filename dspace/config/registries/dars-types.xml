    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>financial</element>
        <qualifier>saleValue</qualifier>
        <scope_note>Sale Value</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>financial</element>
        <qualifier>capital</qualifier>
        <scope_note>Capital Amount</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>financial</element>
        <qualifier>totalContribution</qualifier>
        <scope_note>Total Contribution</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>financial</element>
        <qualifier>totalShares</qualifier>
        <scope_note>Total Shares</scope_note>
    </dc-type>

    <dc-type>
        <schema>dars</schema>
        <element>loan</element>
        <qualifier>startDate</qualifier>
