        <schema>dars</schema>
        <element>property</element>
        <qualifier>cartaDate</qualifier>
        <scope_note>Carta Issue Date</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>property</element>
        <qualifier>houseNumber</qualifier>
        <scope_note>House Number</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>property</element>
        <qualifier>area</qualifier>
        <scope_note>Area in Sqm</scope_note>
    </dc-type>

    <!-- Spatial/Location -->
    <dc-type>
        <schema>dars</schema>
        <element>spatial</element>
        <qualifier>region</qualifier>
        <scope_note>Region</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>spatial</element>
        <qualifier>city</qualifier>
        <scope_note>City</scope_note>
    </dc-type>
    <dc-type>
        <schema>dars</schema>
        <element>spatial</element>
        <qualifier>subcity</qualifier>
